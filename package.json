{
  "name": "song-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
